      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/run-lesson.ps1",
        "-Lesson",
        "${input:lessonNumber}",
        "-Language",
        "${input:lessonLanguage}",
        "-Part",
        "${input:lessonPart}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
