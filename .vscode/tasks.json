{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run tutorial lesson",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/scripts/run-lesson.ps1",
        "-Lesson", "${input:lessonNumber}",
        "-Language", "${input:lessonLanguage}",
        "-Part", "${input:lessonPart}"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ],
  "inputs": [
    {
      "id": "lessonNumber",
      "type": "pickString",
      "description": "Tutorial lesson",
      "options": ["1", "2", "3", "4", "5", "6", "7", "8"],
      "default": "1"
    },
    {
      "id": "lessonLanguage",
      "type": "pickString",
      "description": "Language to run",
      "options": ["c", "java"],
      "default": "c"
    },
    {
      "id": "lessonPart",
      "type": "pickString",
      "description": "Steps to show (step 4 applies to lesson 6)",
      "options": ["all", "1", "2", "3", "4", "1-2", "1-3", "1-4", "2-4", "3-4"],
      "default": "all"
    }
  ]
}
