{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GPT-2: Set up Python",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/../scripts/setup-gpt2-python.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "GPT-2: Inspect scaffold",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/../scripts/run-gpt2.ps1",
        "-Language",
        "${input:gpt2Language}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "GPT-2: Prepare sample experiment",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/../scripts/run-gpt2.ps1",
        "-Language",
        "python",
        "-Action",
        "prepare-run"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "gpt2Language",
      "type": "pickString",
      "description": "GPT-2 scaffold language",
      "options": [
        "python",
        "c",
        "java"
      ],
      "default": "python"
    }
  ]
}
